@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix bs: <urn:bschema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .

bs:AHU_version_1 a brick:AHU ;
    brick:feeds bs:Variable_Air_Volume_Box_With_Reheat_version_1 ;
    brick:hasPart bs:Cooling_Coil_version_1,
        bs:Heating_Coil_version_1,
        bs:Supply_Fan_version_1 ;
    brick:hasPoint bs:Mixed_Air_Temperature_Sensor_version_1,
        bs:Return_Air_Flow_Sensor_version_1,
        bs:Return_Air_Temperature_Sensor_version_1,
        bs:Supply_Air_Flow_Sensor_version_1,
        bs:Supply_Air_Temperature_Sensor_version_1,
        bs:Supply_Air_Temperature_Setpoint_version_1 .

bs:Building_version_1 a brick:Building ;
    brick:area bs:Resource_version_28 ;
    brick:hasPart bs:HVAC_Zone_version_1 .

bs:CO2_Sensor_version_1 a brick:CO2_Sensor ;
    ref:hasExternalReference bs:Resource_version_5 .

bs:Chilled_Water_Return_Temperature_Sensor_version_1 a brick:Chilled_Water_Return_Temperature_Sensor ;
    ref:hasExternalReference bs:Resource_version_16 .

bs:Chilled_Water_Supply_Temperature_Sensor_version_1 a brick:Chilled_Water_Supply_Temperature_Sensor ;
    ref:hasExternalReference bs:Resource_version_26 .

bs:Chiller_version_1 a brick:Chiller ;
    brick:feeds bs:Pump_version_2 ;
    brick:hasPoint bs:Chilled_Water_Return_Temperature_Sensor_version_1,
        bs:Chilled_Water_Supply_Temperature_Sensor_version_1,
        bs:Electric_Power_Sensor_version_6 .

bs:Cooling_Coil_version_1 a brick:Cooling_Coil ;
    brick:hasPoint bs:Electric_Power_Sensor_version_3 ;
    brick:isFedBy bs:Chiller_version_1 .

bs:Damper_Position_Setpoint_version_1 a brick:Damper_Position_Setpoint ;
    ref:hasExternalReference bs:Resource_version_3 .

bs:Discharge_Air_Flow_Sensor_version_1 a brick:Discharge_Air_Flow_Sensor ;
    ref:hasExternalReference bs:Resource_version_2 .

bs:Discharge_Air_Static_Pressure_Sensor_version_1 a brick:Discharge_Air_Static_Pressure_Sensor ;
    ref:hasExternalReference bs:Resource_version_22 .

bs:Discharge_Air_Temperature_Sensor_version_1 a brick:Discharge_Air_Temperature_Sensor ;
    ref:hasExternalReference bs:Resource_version_15 .

bs:Electric_Power_Sensor_version_1 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_20,
        bs:TimeseriesReference_version_10 .

bs:Electric_Power_Sensor_version_2 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_18,
        bs:TimeseriesReference_version_13 .

bs:Electric_Power_Sensor_version_3 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_11,
        bs:TimeseriesReference_version_12 .

bs:Electric_Power_Sensor_version_4 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_19,
        bs:TimeseriesReference_version_2 .

bs:Electric_Power_Sensor_version_5 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_4,
        bs:TimeseriesReference_version_9 .

bs:Electric_Power_Sensor_version_6 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_21,
        bs:TimeseriesReference_version_11 .

bs:Electric_Power_Sensor_version_7 a brick:Electric_Power_Sensor ;
    ref:hasExternalReference bs:Resource_version_23,
        bs:TimeseriesReference_version_7 .

bs:Heating_Coil_version_1 a brick:Heating_Coil ;
    brick:hasPoint rdfs:Resource,
        bs:Electric_Power_Sensor_version_4 ;
    brick:isFedBy bs:Pump_version_1 .

bs:Hot_Water_Pump_version_1 a brick:Hot_Water_Pump ;
    brick:hasPoint bs:Electric_Power_Sensor_version_1 .

bs:Max_Air_Temperature_Setpoint_version_1 a brick:Max_Air_Temperature_Setpoint ;
    ref:hasExternalReference bs:Resource_version_1,
        bs:TimeseriesReference_version_5 .

bs:Min_Air_Temperature_Setpoint_version_1 a brick:Min_Air_Temperature_Setpoint ;
    ref:hasExternalReference bs:Resource_version_10,
        bs:TimeseriesReference_version_4 .

bs:Mixed_Air_Temperature_Sensor_version_1 a brick:Mixed_Air_Temperature_Sensor ;
    ref:hasExternalReference bs:Resource_version_24 .

bs:Occupancy_Sensor_version_1 a brick:Occupancy_Sensor ;
    ref:hasExternalReference bs:Resource_version_9,
        bs:TimeseriesReference_version_1 .

bs:Pump_version_1 a brick:Pump ;
    brick:feeds bs:Hot_Water_Pump_version_1 ;
    brick:hasPoint bs:Electric_Power_Sensor_version_5 .

bs:Pump_version_2 a brick:Pump ;
    brick:hasPoint bs:Electric_Power_Sensor_version_7 .

